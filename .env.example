# Copy to .env.local and fill in. NEVER commit a filled-in file.

# LiveKit is the media and SIP control plane. Agent logic and data run locally.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=alderway-intake

# Outbound telephony. The trunk and caller id come from your SIP provider.
SIP_OUTBOUND_TRUNK_ID=
MAX_CALL_SECONDS=900
# Where a caller goes when they ask for a person.
LICENSED_AGENT_NUMBER=

DEEPGRAM_API_KEY=

# Either a Gemini API key, or Vertex via a service account.
GEMINI_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

TOOLS_API_URL=http://localhost:18092
TOOLS_TIMEOUT_SECONDS=5
# Console and dev runs dial nobody, so they work this seeded lead instead.
DEMO_LEAD_PHONE=+16145550118

COMPANY_NAME=Alderway Insurance Services
AGENT_DISPLAY_NAME=Avery

AGENT_STT_MODEL=nova-3
AGENT_STT_MODEL_PHONE=nova-2-phonecall
AGENT_LLM_MODEL=gemini-2.5-flash
AGENT_LLM_TEMPERATURE=0.3
AGENT_TTS_MODEL=aura-2-andromeda-en
AGENT_ALLOW_INTERRUPTION=1
AGENT_MIN_ENDPOINTING_DELAY=0.6
AGENT_MAX_ENDPOINTING_DELAY=3.5
AGENT_SILENCE_SECONDS=9
AGENT_MAX_TOOL_STEPS=12

# Solicitation calls are bounded to the property's own local hours.
CALLING_EARLIEST_HOUR=9
CALLING_LATEST_HOUR=20
CALLING_SATURDAY_EARLIEST_HOUR=10
CALLING_SATURDAY_LATEST_HOUR=17
# Set to 1 only for local testing outside those hours.
IGNORE_CALLING_WINDOW=

# Set to a directory to keep call transcripts. Off by default: a transcript is personal information.
TRANSCRIPT_DIR=
# Set to a file to trace every tools API call the agent makes.
TOOL_TRACE=
